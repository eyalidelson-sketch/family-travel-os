# Optional. Without this, itinerary parsing falls back to a deterministic
# offline parser that understands the same loose, dated shorthand as the
# product brief's own example — good enough to try the whole flow with zero
# setup, but Claude does a much better job on messy real itineraries.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional for local `npm run dev` — NOT optional for a real deployment.
# Without these, the app runs on a zero-config in-memory repository (see
# lib/repo/index.ts) — perfect for trying it out, but data resets whenever
# the server restarts, and on a serverless host (Vercel) can vanish between
# requests entirely, not just on restart, since each request may land on a
# fresh instance with empty memory. Run db/schema.sql against a real
# Supabase project once, then set both of these (from that project's
# Settings → API page) to switch the whole app — trips, places, photo/text
# enrichment cache, everything — onto real Postgres. See DEPLOYMENT.md for
# the full walkthrough. lib/repo/supabase.ts is a complete implementation
# now, not a stub — this is a straightforward "set two env vars" switch.
SUPABASE_URL=
# The SERVICE ROLE key, not the anon/public key — the server-side repository
# needs it to read/write any trip regardless of Row Level Security. Never
# expose this to the browser (no NEXT_PUBLIC_ prefix, never used from a
# "use client" file).
SUPABASE_SERVICE_ROLE_KEY=

# Both fully optional — with NEITHER set, real (not placeholder) photos and
# descriptions already work for any well-known place, for free, via
# Wikipedia's public API (no key, no signup — see
# lib/providers/photoSources/wikipedia.ts and lib/enrichment/service.ts).
# Google Places and Unsplash are extra tiers on top of that free baseline:
# when configured they're tried FIRST (a real, venue-specific photo beats
# Wikipedia's one general article photo), with Wikipedia as the automatic
# fallback and a deterministic gradient tile as the last resort for
# anything with no Wikipedia article either (a specific hotel or
# restaurant, mostly) — never a fake photo claimed to be something it
# isn't. Set one or both of these to add venue-specific hero photos
# everywhere (Today's cards, the Place Detail gallery, Food Finder): Google
# Places is tried first (real venue photos via a same-origin proxy that
# keeps this key server-side, see app/api/photo-proxy/route.ts), then
# Unsplash (generic but broadly-available editorial photos). Real photos
# are cached for 30 days per place, same as the rest of a place's
# enrichment — see lib/enrichment/photos.ts.
#
# Needs a Google Cloud project with "Places API (New)" enabled and billing
# on (Google's free tier covers light demo use) — console.cloud.google.com.
GOOGLE_PLACES_API_KEY=

# Free at unsplash.com/developers — a demo/development app key is enough to
# try this; Unsplash's production API guidelines ask for photographer
# attribution and a download-tracking ping at real volume, which this demo
# doesn't implement (see the comment in lib/providers/photoSources/unsplash.ts).
UNSPLASH_ACCESS_KEY=
